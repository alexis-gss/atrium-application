<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false">

    <View
        android:id="@+id/bottom_gradient"
        android:layout_width="match_parent"
        android:layout_height="@dimen/home_gradient_height"
        android:layout_gravity="bottom"
        android:background="@drawable/section_gradient"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:id="@+id/home_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/top_bar"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:gravity="center_vertical|end"
            android:orientation="horizontal"
            android:paddingStart="48dp"
            android:paddingEnd="48dp">

            <ImageView
                android:id="@+id/wifi_icon"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginEnd="8dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_wifi"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/system_settings_button"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="12dp"
                android:background="@drawable/topbar_button_background"
                android:clickable="true"
                android:contentDescription="@string/menu_system"
                android:focusable="true"
                android:padding="8dp"
                android:src="@drawable/ic_settings" />

            <ImageView
                android:id="@+id/settings_button"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="12dp"
                android:background="@drawable/topbar_button_background"
                android:clickable="true"
                android:contentDescription="@string/settings_button"
                android:focusable="true"
                android:padding="8dp"
                android:src="@drawable/ic_menu_system" />

            <TextClock
                android:id="@+id/clock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:format12Hour="h:mm a"
                android:format24Hour="HH:mm"
                android:textColor="#FFFFFF"
                android:textSize="22sp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:id="@+id/apps_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical"
            android:paddingStart="40dp"
            android:paddingTop="40dp"
            android:paddingEnd="40dp">

            <TextView
                android:id="@+id/apps_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:drawableStart="@drawable/ic_title_apps"
                android:drawablePadding="8dp"
                android:gravity="center_vertical"
                android:text="@string/apps_title"
                android:textColor="#B0BEC5"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/apps_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="12dp"
                android:text="@string/apps_empty"
                android:textColor="#78909C"
                android:textSize="16sp"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/apps_grid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false" />

            <ImageView
                android:id="@+id/apps_hint"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="12dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_chevron_down" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/inputs_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical"
            android:paddingStart="40dp"
            android:paddingTop="16dp"
            android:paddingEnd="40dp"
            android:paddingBottom="36dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/inputs_hint"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="4dp"
                android:importantForAccessibility="no"
                android:rotation="180"
                android:src="@drawable/ic_chevron_down" />

            <TextView
                android:id="@+id/inputs_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:drawableStart="@drawable/ic_title_inputs"
                android:drawablePadding="8dp"
                android:gravity="center_vertical"
                android:text="@string/inputs_title"
                android:textColor="#B0BEC5"
                android:textSize="18sp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/inputs_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/panel_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <View
            android:id="@+id/panel_scrim"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#99000000"
            android:clickable="true"
            android:importantForAccessibility="no" />

        <LinearLayout
            android:id="@+id/panel"
            android:layout_width="@dimen/panel_width"
            android:layout_height="match_parent"
            android:layout_gravity="end"
            android:layout_marginTop="@dimen/panel_margin"
            android:layout_marginEnd="@dimen/panel_margin"
            android:layout_marginBottom="@dimen/panel_margin"
            android:background="@drawable/panel_background"
            android:clickable="true"
            android:clipToOutline="true"
            android:elevation="24dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/panel_header_background"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="20dp"
                android:paddingTop="14dp"
                android:paddingEnd="20dp"
                android:paddingBottom="12dp">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginEnd="10dp"
                    android:importantForAccessibility="no"
                    android:scaleType="fitCenter"
                    android:src="@drawable/logo" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/panel_date"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:maxLines="1"
                    android:textColor="#90A4AE"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/panel_breadcrumb"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#1AFFFFFF"
                android:ellipsize="start"
                android:maxLines="1"
                android:paddingStart="20dp"
                android:paddingTop="9dp"
                android:paddingEnd="20dp"
                android:paddingBottom="9dp"
                android:textColor="#90CAF9"
                android:textSize="12sp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/panel_list"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:paddingTop="6dp"
                android:paddingBottom="10dp" />

            <LinearLayout
                android:id="@+id/panel_close"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginTop="2dp"
                android:layout_marginEnd="12dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/panel_item_background"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="46dp"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingTop="6dp"
                android:paddingEnd="14dp"
                android:paddingBottom="6dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="14dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_menu_close" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_close"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
